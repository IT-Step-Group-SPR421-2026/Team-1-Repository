@{
    ViewData["Title"] = "About Us";
}

<div class="cyber-wrapper">

    <section class="hero text-center">
        <h1 class="glow-title">SHOPAPP SYSTEM</h1>
        <p class="typing-text">Initializing secure commerce protocol...</p>
    </section>

    <section class="container mt-5">
        <div class="row g-4">

            <div class="col-md-4">
                <div class="cyber-card">
                    <h4>SECURITY</h4>
                    <p>
                        Advanced encrypted payment systems.
                        Your data is protected with modern security layers.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="cyber-card">
                    <h4>PERFORMANCE</h4>
                    <p>
                        Lightning-fast page loading and optimized
                        checkout process for maximum efficiency.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="cyber-card">
                    <h4>CONTROL</h4>
                    <p>
                        Full control over orders, payments and
                        account settings in a minimal interface.
                    </p>
                </div>
            </div>

        </div>
    </section>

    <section class="terminal-box mt-5">
        <p>> system.status: ONLINE</p>
        <p>> encryption.level: MAXIMUM</p>
        <p>> users.connected: 1024</p>
        <p>> access.granted...</p>
    </section>

    <footer class="text-center mt-5">
        <p class="footer-text">
            &copy; @DateTime.Now.Year ShopApp | Secure Commerce Network
        </p>
    </footer>

</div>

<style>
    body {
        background-color: #000;
        color: #00ff88;
        font-family: 'Consolas', monospace;
        overflow-x: hidden;
    }

        /* subtle scanline effect */
        body::before {
            content: "";
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: repeating-linear-gradient( to bottom, rgba(0,255,0,0.05), rgba(0,255,0,0.05) 1px, transparent 1px, transparent 3px );
            pointer-events: none;
            z-index: 9999;
        }

    .hero {
        padding: 100px 20px 40px;
    }

    .glow-title {
        font-size: 50px;
        font-weight: 700;
        text-shadow: 0 0 10px #00ff88, 0 0 20px #00ff88, 0 0 40px #00ff88;
        letter-spacing: 4px;
    }

    .typing-text {
        margin-top: 15px;
        opacity: 0.8;
        animation: blink 1.2s infinite;
    }

    @@keyframes blink {
        0%, 100% {
            opacity: 0.4;
        }

        50% {
            opacity: 1;
        }
    }

    .cyber-card {
        background: #0a0a0a;
        border: 1px solid #00ff88;
        border-radius: 12px;
        padding: 30px;
        transition: 0.3s ease;
        box-shadow: 0 0 10px rgba(0,255,136,0.2);
    }

        .cyber-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 0 15px #00ff88, 0 0 30px #00ff88, 0 0 60px rgba(0,255,136,0.5);
        }

        .cyber-card h4 {
            margin-bottom: 15px;
            font-weight: 600;
            letter-spacing: 2px;
        }

    .terminal-box {
        max-width: 600px;
        margin: auto;
        background: #050505;
        border: 1px solid #00ff88;
        padding: 25px;
        border-radius: 10px;
        box-shadow: 0 0 20px rgba(0,255,136,0.3);
    }

        .terminal-box p {
            margin: 5px 0;
        }

    .footer-text {
        opacity: 0.6;
        font-size: 14px;
    }
</style>

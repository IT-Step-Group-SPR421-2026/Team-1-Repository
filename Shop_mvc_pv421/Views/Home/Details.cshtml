@model Shop_mvc_pv421.Data.Entities.Product

@{
    ViewData["Title"] = "Product Details";
}

<h2>@Model.Title</h2>

<div class="row">
    <div class="col-md-4">
        <img src="@(Model.ImageUrl ?? "https://thumbs.dreamstime.com/b/no-image-icon-vector-available-picture-symbol-isolated-white-background-suitable-user-interface-element-205805243.jpg")"
             class="img-fluid" />
    </div>

    <div class="col-md-8">
        <p><b>Description:</b> @Model.Description</p>
        <p><b>Category:</b> @Model.Category?.Name</p>
        <p><b>Price:</b> @Model.Price$</p>
        <p><b>Discount:</b> @Model.Discount%</p>
        <p><b>Quantity:</b> @Model.Quantity</p>
    </div>
</div>

<a asp-action="Index" class="btn btn-secondary mt-3">Back</a>
